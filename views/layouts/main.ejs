<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof titulo !== "undefined" ? titulo : "Reservas de salas" %></title>
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
  <header class="sitio-header">
    <div class="contenedor barra-navegacion">
      <a class="marca" href="/">Salas de estudio</a>
      <nav class="navegacion" aria-label="Navegación principal">
        <a href="/">Inicio</a>
        <a href="/reservas">Reservas</a>
        <a href="/reservas/nueva">Nueva reserva</a>
      </nav>
    </div>
  </header>

  <main class="contenedor contenido-principal">
    <%- body %>
  </main>

  <footer class="sitio-footer">
    <div class="contenedor pie-contenido">
      <p>Trabajo práctico 05 · Reservas de salas de estudio</p>
      <% if (typeof solicitudId !== "undefined" && solicitudId) { %>
        <p class="solicitud-id">Solicitud: <%= solicitudId %></p>
      <% } %>
    </div>
  </footer>
</body>
</html>
